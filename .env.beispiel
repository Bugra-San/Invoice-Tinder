# Einstellungen für Rechnungs-Tinder auf dem Server.
# Diese Datei nach ".env" kopieren und anpassen. Die .env enthält Passwörter –
# nicht weitergeben und nicht ins Git einchecken.

# PIN zum Anmelden (Browser, Smartphone, später iOS-App). Mindestens 6 Ziffern empfohlen.
PIN=482913

# Port, unter dem das Programm erreichbar ist:  http://<server>:8765
PORT=8765

# Ordner mit den Rechnungen auf dem Server (bzw. auf dem NAS, wenn der Container dort läuft).
# Unterordner sind in der App auswählbar.
RECHNUNGEN_ORDNER=/mnt/nas/rechnungen

# Benutzer-/Gruppen-ID mit Schreibrechten auf den Rechnungsordner
# (Linux: "id <benutzer>", Synology: "id" im SSH-Terminal).
PUID=1000
PGID=1000

# Namen der Zielordner (innerhalb des jeweils geöffneten Rechnungsordners)
ORDNER_BEWILLIGT=Bewilligt
ORDNER_ABGELEHNT=Abgelehnt

# 1, wenn ein Reverse-Proxy (z. B. für HTTPS) davor sitzt
HINTER_PROXY=0

# --- nur für docker-compose.nas.yml (NAS-Freigabe direkt per SMB einbinden) ---
NAS_ADRESSE=192.168.1.10
NAS_FREIGABE=Rechnungen
NAS_BENUTZER=rechnungen
# Hinweis: Das Passwort darf kein Komma enthalten.
NAS_PASSWORT=geheim
SMB_VERSION=3.0
